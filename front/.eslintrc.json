{
    "env": {
        "browser": true,
        "es2021": true
    },
    "extends": [
        "eslint:recommended",
        "plugin:@typescript-eslint/recommended",
        "plugin:react-hooks/recommended",
        "plugin:prettier/recommended",
        "plugin:storybook/recommended",
        "plugin:@tanstack/query/recommended"
    ],
    "ignorePatterns": ["dist", "craco.config.js", ".eslintrc.json"],
    "parser": "@typescript-eslint/parser",
    "parserOptions": {
        "ecmaVersion": "latest",
        "sourceType": "module"
    },
    "plugins": ["@tanstack/query", "@typescript-eslint", "react", "prettier"],
    "rules": {
        "prettier/prettier": [
            "error",
            {
                "endOfLine": "lf",
                "singleQuote": true,
                "semi": true
            }
        ]
    }
}
